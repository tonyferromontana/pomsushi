{
  "expo": {
    "name": "RUÉ",
    "slug": "rue",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rue",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101114",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.rue.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "RUÉ usa tus fotos para mostrar tu vehículo en la publicación.",
        "NSCameraUsageDescription": "RUÉ usa la cámara para fotografiar tu vehículo."
      }
    },
    "android": {
      "package": "cl.rue.app",
      "adaptiveIcon": {
        "backgroundColor": "#101114",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "RUÉ usa tus fotos para mostrar tu vehículo en la publicación.",
          "cameraPermission": "RUÉ usa la cámara para fotografiar tu vehículo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101114",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
