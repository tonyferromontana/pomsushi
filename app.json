{
  "expo": {
    "name": "RUÉ",
    "slug": "rue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rue",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101114",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.rue.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "RUÉ usa tus fotos para mostrar tu vehículo en la publicación.",
        "NSCameraUsageDescription": "RUÉ usa la cámara para fotografiar tu vehículo y tus documentos de verificación."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cl.rue.app",
      "adaptiveIcon": {
        "backgroundColor": "#101114",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "RUÉ usa tus fotos para mostrar tu vehículo en la publicación.",
          "cameraPermission": "RUÉ usa la cámara para fotografiar tu vehículo y tus documentos de verificación."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101114",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D7FF3F",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Arrienda autos, motos, camionetas, vans, furgones y camiones directo de sus dueños. Haz producir lo que tienes parado.",
    "extra": {
      "eas": {
        "projectId": "70cfc9b5-5885-46e4-a4a2-132cf1f20773"
      }
    },
    "owner": "tonymontana369"
  }
}
