# Copia este archivo como ".env" y completa los dos valores.
# Supabase → tu proyecto → Project Settings → API (o "Connect").
#
# SOLO datos públicos aquí. Nunca pongas la service_role key ni tokens de Mercado Pago.

# Project URL, ej: https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://pega-aqui-tu-proyecto.supabase.co

# anon public key (empieza con "eyJ...") o publishable key (empieza con "sb_publishable_...")
EXPO_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-tu-anon-key
